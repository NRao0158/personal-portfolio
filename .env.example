# Optional production origin. Vercel's production domain is detected automatically.
# Set explicitly when using a custom domain or a host other than Vercel.
# Example: VITE_SITE_URL=https://your-real-domain.com
VITE_SITE_URL=

# Use / for Vercel or a custom domain. For repository GitHub Pages:
# VITE_BASE_PATH=/personal-portfolio/
VITE_BASE_PATH=/
